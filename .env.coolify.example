APP_NAME="Dispatch Logistics"
APP_ENV=production
APP_KEY=base64:0PGyRJTWG4a6ocqcgjJlSkNG527/D7bj3LRY/0Zv3AY=
APP_DEBUG=false
APP_URL=https://YOUR-COOLIFY-DOMAIN.sslip.io
APP_TIMEZONE=Africa/Mogadishu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=YOUR-MYSQL-SERVICE-HOST
DB_PORT=3306
DB_DATABASE=default
DB_USERNAME=mysql
DB_PASSWORD=YOUR-MYSQL-PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS=Dispatchlogistics@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

RAILPACK_PHP_EXTENSIONS=gd,zip,pdo_mysql,bcmath,intl,exif
RAILPACK_PHP_ROOT_DIR=/app/public

# Use these with Coolify Nixpacks (this project’s build pack):
NIXPACKS_PHP_ROOT_DIR=/app/public
